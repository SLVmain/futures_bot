[Unit]
Description=Bitunix futures Telegram bot (Amazon server)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/futures_bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/futures_bot/venv/bin/python /home/ubuntu/futures_bot/telegram_bot.py
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
